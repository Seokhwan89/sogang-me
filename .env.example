# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Secret admin path: site is managed at https://<domain>/<ADMIN_PATH>
ADMIN_PATH=adm
# Public site URL
NEXT_PUBLIC_SITE_URL=https://me.sogang.ac.kr
# Translation: leave ANTHROPIC_API_KEY empty to use the free translator (Google web endpoint / MyMemory).
# Set a key later to switch to Claude translation (higher quality) with no code change.
ANTHROPIC_API_KEY=
TRANSLATE_CONTACT_EMAIL=me@sogang.ac.kr
